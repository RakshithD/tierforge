DATABASE_URL=postgresql://tierforge:tierforge@localhost:5433/tierforge
ENRICHMENT_API_URL=http://localhost:8001
PORT=8000
CORS_ORIGIN=http://localhost:5173

# worker tuning
RATE_LIMIT_PER_SEC=4
MAX_IN_FLIGHT=20
REQUEST_TIMEOUT_MS=5000
LEASE_SECONDS=15
MAX_ATTEMPTS=6
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=30000
BREAKER_WINDOW=30
BREAKER_FAILURE_RATIO=0.9

# auto-resume: after the breaker trips the job is PAUSED, probed every PAUSE_PROBE_MS,
# resumed on success, and marked FAILED after PAUSE_MAX_MS of continuous outage
PAUSE_PROBE_MS=5000
PAUSE_MAX_MS=1800000
